${packaging.scripts.header}

#
# This script is executed in the pre-installation phase
#
#   On Debian,
#       $1=install : indicates an new install
#       $1=upgrade : indicates an upgrade
#
#   On RedHat,
#       $1=1       : indicates an new install
#       $1=2       : indicates an upgrade



# Sets the default values for fess variables used in this script
FESS_USER="${packaging.fess.user}"
FESS_GROUP="${packaging.fess.group}"
FESS_USER_HOME="${packaging.fess.var.dir}"

# Source the default env file
FESS_ENV_FILE="${packaging.env.file}"
if [ -f "$FESS_ENV_FILE" ]; then
    . "$FESS_ENV_FILE"
fi

case "$1" in

    # Debian ####################################################
    install|upgrade)

        # The files under the configuration directory became conffiles in 15.9.
        # When upgrading from an older version, dpkg does not know them as
        # conffiles yet and asks about every one that differs from the new
        # package, edited or not (the default answer, and --force-confold, keep
        # the old file). Remove the files that still match the md5sums of the
        # installed package, so that dpkg installs the new copy without a
        # question. Files the operator edited stay and are handled as usual.
        if [ "$1" = "upgrade" ] && dpkg --compare-versions "$2" lt 15.9~; then
            OLD_MD5SUMS="$(dpkg-query --control-path fess md5sums 2>/dev/null || true)"
            if [ -n "$OLD_MD5SUMS" ] && [ -f "$OLD_MD5SUMS" ]; then
                while read -r OLD_MD5 OLD_FILE; do
                    case "/$OLD_FILE" in
                        "${packaging.fess.conf.dir}"/*)
                            if [ -f "/$OLD_FILE" ] && [ "$(md5sum "/$OLD_FILE" | cut -d ' ' -f 1)" = "$OLD_MD5" ]; then
                                rm -f "/$OLD_FILE"
                            fi
                        ;;
                    esac
                done < "$OLD_MD5SUMS"
            fi
        fi

        # tika.xml is not part of the package since 15.10 (Tika is configured in
        # the code). It was a conffile in 15.9, so dpkg would keep it as an
        # obsolete conffile. Remove it when the operator has not edited it, and
        # keep it as tika.xml.dpkg-bak when they have. This comes after the
        # clean-up above, which has already removed an unedited copy of 15.8.
        dpkg-maintscript-helper rm_conffile ${packaging.fess.conf.dir}/tika.xml 15.10.0~ -- "$@"

        # Create fess group if not existing
        if ! getent group "$FESS_GROUP" > /dev/null 2>&1 ; then
            echo -n "Creating $FESS_GROUP group..."
            addgroup --quiet --system "$FESS_GROUP"
            echo " OK"
        fi

        # Create fess user if not existing
        if ! id $FESS_USER > /dev/null 2>&1 ; then
            echo -n "Creating $FESS_USER user..."
            adduser --quiet \
                    --system \
                    --no-create-home \
                    --ingroup "$FESS_GROUP" \
                    --disabled-password \
                    --shell /bin/false \
                    --home "$FESS_USER_HOME"  \
                    "$FESS_USER"
            echo " OK"
        fi
    ;;
    abort-deconfigure|abort-upgrade|abort-remove)
    ;;

    # RedHat ####################################################
    1|2)

        # Create fess group if not existing
        if ! getent group "$FESS_GROUP" > /dev/null 2>&1 ; then
            echo -n "Creating $FESS_GROUP group..."
            groupadd -r "$FESS_GROUP"
            echo " OK"
        fi

        # Create fess user if not existing
        if ! id $FESS_USER > /dev/null 2>&1 ; then
            echo -n "Creating $FESS_USER user..."
            useradd --system \
                    -M \
                    --gid "$FESS_GROUP" \
                    --shell /sbin/nologin \
                    --comment "fess user" \
                    -d "$FESS_USER_HOME"  \
                    "$FESS_USER"
            echo " OK"
        fi
    ;;

    *)
        echo "pre install script called with unknown argument \`$1'" >&2
        exit 1
    ;;
esac

${packaging.scripts.footer}
